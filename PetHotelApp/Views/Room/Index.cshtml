@model IEnumerable<PetHotelApp.Models.RoomModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Rooms</h1>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create">Create New</a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Capacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PricePerDay)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RoomType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Capacity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PricePerDay)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RoomType)
            </td>
                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.IdRoom">Edit</a>
                        <a asp-action = "Delete" asp-route-id = "@item.IdRoom" >Delete</a > 
                    }
                    <a asp-action="Details" asp-route-id="@item.IdRoom">Details</a>
                </td>
        </tr>
}
    </tbody>
</table>
