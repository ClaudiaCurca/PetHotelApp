@model PetHotelApp.Models.RoomModel

@{
    ViewData["Title"] = "Details";
}

<h1>Room Details</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Capacity</dt>
    <dd class="col-sm-9">@Model.Capacity</dd>

    <dt class="col-sm-3">Price Per Day</dt>
    <dd class="col-sm-9">@Model.PricePerDay</dd>

    <dt class="col-sm-3">Room Type</dt>
    <dd class="col-sm-9">@Model.RoomType</dd>
</dl>

<div class="mt-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit"
           asp-route-id="@Model.IdRoom"
           class="btn btn-sm btn-primary me-1">
            Edit
        </a>
    }

    <a asp-action="Index"
       class="btn btn-sm btn-secondary">
        Back to List
    </a>
</div>
