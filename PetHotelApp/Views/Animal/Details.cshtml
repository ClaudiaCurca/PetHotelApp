@model PetHotelApp.Models.AnimalModel

@{
    ViewData["Title"] = "Animal Details";
}

<h1 class="mb-4">Animal Details</h1>

<div class="card mb-4 shadow-sm">
    <div class="row g-0">
        <div class="col-md-4 text-center p-3">
            @if (!string.IsNullOrEmpty(Model.Photo))
            {
                <img src="@Model.Photo" class="img-fluid rounded" alt="@Model.Name" />
            }
            else
            {
                <img src="~/images/placeholder.png" class="img-fluid rounded" alt="No photo available" />
            }
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h4 class="card-title">@Model.Name</h4>
                <table class="table table-borderless">
                    <tbody>
                        @if(User.IsInRole("Admin"))
                        {
                            <tr>
                                <th>Owner ID</th>
                                <td>@Model.IdOwner</td>
                            </tr>

                            <tr>
                                <th>Owner Name</th>
                                <td>@Model.Owner?.FirstName @Model.Owner?.LastName</td>
                            </tr>
                        }
                        <tr>
                            <th>Breed</th>
                            <td>@Model.Breed</td>
                        </tr>
                        <tr>
                            <th>Date of Birth</th>
                            <td>@Model.DateOfBirth.ToShortDateString()</td>
                        </tr>
                        <tr>
                            <th>Notes</th>
                            <td>@Model.Notes</td>
                        </tr>
                    </tbody>
                </table>
                <div class="mt-3">
                    @Html.ActionLink("Edit", "Edit", new { id = Model.IdAnimal }, new { @class = "btn btn-primary me-2" })
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
