@model IEnumerable<PetHotelApp.Models.RoomAllocationModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Allocations</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AnimalName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RoomType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CheckInDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CheckOutDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @Html.HiddenFor(modelItem => item.IdRoom)
                @Html.HiddenFor(modelItem => item.IdAnimal)
                <td>
                    @Html.DisplayFor(modelItem => item.AnimalName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RoomType)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CheckInDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CheckOutDate)
                </td>
                <td class="text-nowrap">
                    <a asp-action="Edit"
                       asp-route-id="@item.IdAllocation"
                       class="btn btn-sm btn-primary me-1">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.IdAllocation"
                       class="btn btn-sm btn-info me-1">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.IdAllocation"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
