@model PetHotelApp.Models.RoomAllocationModel

@{
    ViewData["Title"] = "Details";
}

<h1>Room Allocation Details</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Room</dt>
    <dd class="col-sm-9">@Model.IdRoom</dd>

    <dt class="col-sm-3">Animal</dt>
    <dd class="col-sm-9">@Model.IdAnimal</dd>

    <dt class="col-sm-3">Check-in Date</dt>
    <dd class="col-sm-9">@Model.CheckInDate.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Check-out Date</dt>
    <dd class="col-sm-9">@Model.CheckOutDate.ToString("dd/MM/yyyy")</dd>
</dl>

<div class="mt-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit"
           asp-route-id="@Model.IdAllocation"
           class="btn btn-sm btn-primary me-1">
            Edit
        </a>
    }

    <a asp-action="Index"
       class="btn btn-sm btn-secondary">
        Back to List
    </a>
</div>
