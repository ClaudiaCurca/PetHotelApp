@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4">Welcome to Pet Hotel 🐾</h1>
        <p class="lead mt-3">
            A safe, comfortable, and loving place for your pets while you're away.
        </p>
    </div>

    <hr class="my-5" />

    <div class="row text-center">
        <div class="col-md-4">
            <h3>🐱 Our Animals</h3>
            <p>View and manage all registered pets staying at our hotel.</p>
            <a asp-controller="Animal" asp-action="Index" class="btn btn-primary">
                View Animals
            </a>
        </div>

        <div class="col-md-4">
            <h3>👤 Owners</h3>
            <p>Manage pet owners and their contact information.</p>
            <a asp-controller="Owner" asp-action="Index" class="btn btn-success">
                View Owners
            </a>
        </div>

        <div class="col-md-4">
            <h3>📅 Reservations</h3>
            <p>Handle bookings and pet stays efficiently.</p>
            <a asp-controller="Reservation" asp-action="Index" class="btn btn-warning">
                View Reservations
            </a>
        </div>
    </div>

    <hr class="my-5" />

    <div class="text-center mb-4">
        <h2>Our Happy Guests 🐈</h2>
        <p class="text-muted">Some of the lovely pets staying at our hotel</p>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <img src="https://img.freepik.com/free-photo/portrait-beautiful-purebred-pussycat-with-shorthair-orange-collar-neck-sitting-floor-reacting-camera-flash-scared-looking-light-indoor_8353-12551.jpg?semt=ais_hybrid&w=740&q=80"
                 class="gallery-img"
                 alt="tom" />
        </div>

        <div class="col-md-4 mb-4">
            <img src="https://images.unsplash.com/photo-1702203267879-dd8cde43acd7?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Nnx8c2l0dGluZyUyMGNhdHxlbnwwfHwwfHx8MA%3D%3D"
                 class="gallery-img"
                 alt="Cute cat" />
        </div>

        <div class="col-md-4 mb-4">
            <img src="https://images.pexels.com/photos/1170986/pexels-photo-1170986.jpeg?auto=compress&cs=tinysrgb&dpr=1&w=500"
                 class="gallery-img"
                 alt="Playful puppy" />
        </div>
    </div>

    <div class="text-center">
        <p class="text-muted">
            © @DateTime.Now.Year - Pet Hotel App
        </p>
    </div>
</div>
