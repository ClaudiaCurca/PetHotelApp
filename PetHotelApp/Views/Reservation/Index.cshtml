@model IEnumerable<PetHotelApp.Models.ReservationModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Reservations</h1>

@if (User.IsInRole("User"))
{
    <p>
    <a asp-action="Create">Create New</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>Pet</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Owner Last Name</th>
                <th>Owner First Name</th>
            }
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Animal?.Name</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>@item.Animal?.Owner?.LastName</td>
                    <td>@item.Animal?.Owner?.FirstName</td>
                }
                <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                <td>@item.Status</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.IdReservation }) |
                    @Html.ActionLink("Details", "Details", new { id = item.IdReservation }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.IdReservation })
                </td>
            </tr>
        }
    </tbody>
</table>

